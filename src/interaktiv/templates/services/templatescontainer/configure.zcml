<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    >
  <plone:service
      method="GET"
      factory=".get.InteraktivTemplatesContainerGet"
      for="*"
      permission="zope2.View"
      layer="interaktiv.templates.interfaces.IInteraktivTemplatesLayer"
      name="@templates-container"
      />
</configure>
