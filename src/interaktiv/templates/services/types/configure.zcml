<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    >
  <plone:service
      method="GET"
      accept="application/json,application/schema+json"
      factory=".get.InteraktivTemplatesTypesGet"
      for="*"
      permission="zope2.View"
      layer="interaktiv.templates.interfaces.IInteraktivTemplatesLayer"
      name="@types"
      />
</configure>
