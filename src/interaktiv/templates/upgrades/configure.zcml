<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    >

    <genericsetup:upgradeStep
        source="1000"
        destination="1001"
        title="Change meta_type of template_thumbnail index"
        description="Change meta_type of template_thumbnail index"
        profile="interaktiv.templates:default"
        handler="interaktiv.templates.upgrades.v1000_to_v1001.upgrade"
    />

</configure>
