<?xml version="1.0" encoding="utf-8"?>
<dc-workflow description="Workflow for Template and TemplatesContainer Contenttype."
             initial_state="published_internally"
             manager_bypass="False"
             state_variable="review_state"
             title="Template Workflow"
             workflow_id="template_workflow"
>

  <!-- Permissions -->
  <permission>View</permission>
  <permission>Access contents information</permission>
  <permission>List folder contents</permission>
  <permission>Modify portal content</permission>
  <permission>Add portal content</permission>
  <permission>interaktiv.templates: Add Template</permission>
  <permission>interaktiv.templates: Add TemplatesContainer</permission>
  <permission>Delete objects</permission>

  <!-- Status: Published Internally -->
  <state state_id="published_internally"
         title="Published Internally"
  >
    <permission-map acquired="False"
                    name="View"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Site Administrator</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Access contents information"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Site Administrator</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="List folder contents"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Site Administrator</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Modify portal content"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Site Administrator</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Add portal content"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Site Administrator</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="interaktiv.templates: Add Template"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Site Administrator</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="interaktiv.templates: Add TemplatesContainer"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Site Administrator</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
    <permission-map acquired="False"
                    name="Delete objects"
    >
      <permission-role>Owner</permission-role>
      <permission-role>Site Administrator</permission-role>
      <permission-role>Manager</permission-role>
    </permission-map>
  </state>

</dc-workflow>
